package consumer

import (
	"testing"

	generated "example.com/consumer/schema"
	"github.com/im-wmkong/gorm-query/test/model"
	"github.com/stretchr/testify/require"
	"gorm.io/driver/sqlite"
	"gorm.io/gorm"
	"gorm.io/gorm/schema"
)

func TestGeneratedQuery(t *testing.T) {
	d, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{NamingStrategy: NAMING_STRATEGY})
	require.NoError(t, err)
	sqlDB, err := d.DB()
	require.NoError(t, err)
	defer sqlDB.Close()
	require.NoError(t, d.AutoMigrate(&model.Record{}))
	require.NoError(t, d.Create(&model.Record{Name: "first"}).Error)
	var out []model.Record
	err = generated.Record.Query().Where(generated.Record.Name.Eq("first")).Apply(d.Model(&model.Record{})).Find(&out).Error
	require.NoError(t, err)
	require.Len(t, out, 1)
	require.Equal(t, "first", out[0].Name)
}
